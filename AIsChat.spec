        'sqlalchemy.dialects.sqlite.aiosqlite',
        'aiosqlite',
        'greenlet',
        'fastapi.middleware.cors',
        'fastapi.staticfiles',
        'passlib.context',
        'passlib.hash.bcrypt',
        'passlib.hash.sha256_crypt',
        'jose',
        'jose.jwt',
        'jose.jws',
        'jose.jwe',
        'httpx',
        'PIL',
        'bcrypt',
        'python_multipart',
        'cryptography.fernet',
    ] + collect_submodules('passlib', filter=lambda name: not name.startswith('passlib.tests')) + collect_submodules('jose'),
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        'pytest',
